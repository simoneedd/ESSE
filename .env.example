# Personal OS - variabili d'ambiente (SOLO segnaposto: non inserire valori reali qui)
# Sviluppo: copia in .env.local. Produzione: Vercel > Settings > Environment Variables e GitHub Actions secrets.
# Credenziali SEPARATE da IronEdge Growth OS: progetto Supabase, chiavi e segreti dedicati.

# --- Pubbliche (esposte al browser, protette da RLS) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_ENV=development    # development | staging | production

# --- Solo server (MAI con prefisso NEXT_PUBLIC_) ---
SUPABASE_SERVICE_ROLE_KEY=         # solo scheduler, sync e callback OAuth
APP_URL=                           # es. https://personal-os.vercel.app (redirect OAuth)
OWNER_USER_ID=                     # UUID del tuo utente Supabase: job e Security Center solo per te
CRON_SECRET=                       # >= 32 caratteri casuali; stesso valore nel secret GitHub CRON_SECRET
SECURITY_INGEST_SECRET=            # >= 32 caratteri casuali; stesso valore nel secret GitHub
TOKEN_ENCRYPTION_KEY=              # 32 byte in base64: openssl rand -base64 32

# --- IronEdge Growth OS (server-to-server, firmato HMAC) ---
IRONEDGE_BASE_URL=                 # es. https://ironedge-growth-os.vercel.app
IRONEDGE_SHARED_SECRET=            # >= 32 caratteri; stesso valore di PERSONAL_OS_SHARED_SECRET in IronEdge

# --- Google Calendar (OAuth 2.0, client "Applicazione web") ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=              # redirect URI autorizzato: $APP_URL/api/google/callback

# --- Telegram (bot DEDICATO a Personal OS, opzionale) ---
TELEGRAM_BOT_TOKEN=

# --- Assistente AI (opzionale, disattivato di default) ---
AI_PROVIDER=none                   # none | anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5           # claude-sonnet-5-5 / claude-haiku-5-5 riducono i costi
AI_MONTHLY_BUDGET_USD=0            # 0 = AI disattivata
AI_MAX_REQUESTS_PER_DAY=30
