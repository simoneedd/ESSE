{
  "name": "personal-os",
  "version": "0.1.0",
  "private": true,
  "description": "Personal OS - assistente esecutivo personale (Next.js + Supabase), integrato con IronEdge Growth OS",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "security:audit": "node scripts/security-audit.mjs",
    "security:secrets": "node scripts/secret-scan.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.14.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.2",
    "lucide-react": "1.80.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.6.0",
    "@types/node": "26.6.7",
    "@types/react": "19.3.1",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  }
}
