diff --git a/supabase/migrations/20261126000001_personal_os_integration.sql b/supabase/migrations/20261126000001_personal_os_integration.sql
new file mode 100644
index 0000000..212708e
--- /dev/null
+++ b/supabase/migrations/20261126000001_personal_os_integration.sql
@@ -0,0 +1,106 @@
+-- IronEdge Growth OS - interfaccia di integrazione con Personal OS (migrazione ADDITIVA)
+-- * nuove colonne opzionali sulle task (NULL = non indicato): nessun impatto sul codice esistente;
+-- * tabella nonce per la protezione da replay delle richieste firmate;
+-- * due funzioni SOLO service role, limitate a un workspace, usate dall'API firmata.
+-- Rollback: supabase/rollback/20261126000001_down.sql
+
+alter table public.tasks
+  add column if not exists priority smallint check (priority is null or priority between 1 and 4),
+  add column if not exists estimated_minutes integer check (estimated_minutes is null or estimated_minutes between 5 and 1440),
+  add column if not exists category text check (category is null or char_length(category) <= 80),
+  add column if not exists depends_on uuid[] not null default '{}';
+
+-- versione dell'occorrenza per il rilevamento dei conflitti
+create index if not exists task_occ_ws_updated_idx on public.task_occurrences(workspace_id, updated_at);
+create index if not exists tasks_ws_updated_idx on public.tasks(workspace_id, updated_at);
+
+-- nonce monouso (finestra 10 minuti), nessun accesso utente
+create table public.integration_nonces (
+  nonce text primary key check (nonce ~ '^[a-f0-9]{32}$'),
+  client text not null check (client in ('personal_os')),
+  received_at timestamptz not null default now()
+);
+alter table public.integration_nonces enable row level security;
+alter table public.integration_nonces force row level security;
+revoke all on public.integration_nonces from anon, authenticated;
+grant all on public.integration_nonces to service_role;
+
+create or replace function public.integration_use_nonce(p_nonce text) returns boolean
+language plpgsql security definer set search_path = '' as $$
+declare n integer;
+begin
+  if not app.is_service() then raise exception 'Solo service role' using errcode = '42501'; end if;
+  delete from public.integration_nonces where received_at < now() - interval '10 minutes';
+  insert into public.integration_nonces (nonce, client) values (p_nonce, 'personal_os') on conflict do nothing;
+  get diagnostics n = row_count;
+  return n = 1;
+end $$;
+
+-- Elenco incrementale delle occorrenze (cursore = versione massima vista)
+create or replace function public.integration_list_tasks(p_ws uuid, p_since timestamptz, p_from date, p_to date, p_limit integer default 200)
+returns table (
+  occurrence_id uuid, task_id uuid, title text, description text, priority smallint, due_date date,
+  occurrence_date date, estimated_minutes integer, status public.occurrence_status, category text,
+  depends_on uuid[], completed_at timestamptz, version timestamptz, task_active boolean
+)
+language plpgsql stable security definer set search_path = '' as $$
+begin
+  if not app.is_service() then raise exception 'Solo service role' using errcode = '42501'; end if;
+  return query
+  select o.id, t.id, t.title, t.description, t.priority, t.due_date, o.occurrence_date, t.estimated_minutes,
+         o.status, t.category, t.depends_on, o.completed_at, greatest(o.updated_at, t.updated_at) as version, t.active
+    from public.task_occurrences o
+    join public.tasks t on t.id = o.task_id
+   where o.workspace_id = p_ws
+     and o.occurrence_date between p_from and p_to
+     and (p_since is null or greatest(o.updated_at, t.updated_at) > p_since)
+   order by greatest(o.updated_at, t.updated_at), o.id
+   limit greatest(1, least(p_limit, 500));
+end $$;
+
+-- Cambio di stato da Personal OS. IronEdge resta autorevole:
+--  * stato gia' uguale -> noop (idempotente);
+--  * occorrenza modificata in IronEdge dopo la versione nota a Personal OS -> conflict (nessuna scrittura);
+--  * l'attore deve essere owner/editor del workspace.
+create or replace function public.integration_set_occurrence_status(
+  p_ws uuid, p_occurrence uuid, p_status public.occurrence_status, p_actor uuid, p_base_version timestamptz
+) returns jsonb
+language plpgsql security definer set search_path = '' as $$
+declare o public.task_occurrences%rowtype; ver timestamptz;
+begin
+  if not app.is_service() then raise exception 'Solo service role' using errcode = '42501'; end if;
+  if p_status not in ('open', 'done') then raise exception 'Stato non consentito' using errcode = '22023'; end if;
+  if not exists (select 1 from public.memberships m where m.workspace_id = p_ws and m.user_id = p_actor and m.role in ('owner', 'editor')) then
+    raise exception 'Attore non autorizzato sul workspace' using errcode = '42501';
+  end if;
+  select * into o from public.task_occurrences where id = p_occurrence and workspace_id = p_ws for update;
+  if not found then
+    return jsonb_build_object('result', 'not_found', 'status', null, 'version', null, 'completed_at', null);
+  end if;
+  select greatest(o.updated_at, t.updated_at) into ver from public.tasks t where t.id = o.task_id;
+  if o.status = p_status then
+    return jsonb_build_object('result', 'noop', 'status', o.status, 'version', ver, 'completed_at', o.completed_at);
+  end if;
+  if p_base_version is not null and o.updated_at > p_base_version then
+    return jsonb_build_object('result', 'conflict', 'status', o.status, 'version', ver, 'completed_at', o.completed_at);
+  end if;
+  update public.task_occurrences
+     set status = p_status,
+         completed_at = case when p_status = 'done' then now() else null end,
+         completed_by = case when p_status = 'done' then p_actor else null end
+   where id = o.id
+  returning * into o;
+  insert into public.audit_events (workspace_id, actor_id, action, entity, entity_id, changes)
+  values (p_ws, p_actor, 'personal_os_status', 'task_occurrences', o.id, jsonb_build_object('fields', array['status']));
+  select greatest(o.updated_at, t.updated_at) into ver from public.tasks t where t.id = o.task_id;
+  return jsonb_build_object('result', 'applied', 'status', o.status, 'version', ver, 'completed_at', o.completed_at);
+end $$;
+
+revoke execute on function public.integration_use_nonce(text),
+  public.integration_list_tasks(uuid, timestamptz, date, date, integer),
+  public.integration_set_occurrence_status(uuid, uuid, public.occurrence_status, uuid, timestamptz)
+  from authenticated, anon, public;
+grant execute on function public.integration_use_nonce(text),
+  public.integration_list_tasks(uuid, timestamptz, date, date, integer),
+  public.integration_set_occurrence_status(uuid, uuid, public.occurrence_status, uuid, timestamptz)
+  to service_role;
