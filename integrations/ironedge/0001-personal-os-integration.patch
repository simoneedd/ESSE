+++ b/tests/unit/personal-os.test.ts
@@ -0,0 +1,120 @@
+import type { SupabaseClient } from "@supabase/supabase-js";
+import { describe, expect, it, vi } from "vitest";
+import type { ServerEnv } from "@/lib/env";
+import { handlePersonalOs } from "@/lib/personal-os";
+import { HEADER, signedHeaders, verifySignedRequest } from "@/lib/personal-os-protocol";
+
+const SECRET = "s".repeat(40);
+const WS = "11111111-1111-4111-8111-111111111111";
+const ACTOR = "22222222-2222-4222-8222-222222222222";
+const OCC = "33333333-3333-4333-8333-333333333333";
+const env = (over: Partial<ServerEnv> = {}): ServerEnv => ({
+  AI_PROVIDER: "none",
+  AI_MODEL: "claude-opus-5-5",
+  AI_MONTHLY_BUDGET_USD: 0,
+  AI_MAX_REQUESTS_PER_DAY: 20,
+  PERSONAL_OS_SHARED_SECRET: SECRET,
+  PERSONAL_OS_WORKSPACE_ID: WS,
+  PERSONAL_OS_ACTOR_USER_ID: ACTOR,
+  ...over,
+});
+
+function fakeAdmin(rpcImpl: (fn: string, args: Record<string, unknown>) => { data: unknown; error: null | { message: string } }) {
+  const rpc = vi.fn(async (fn: string, args: Record<string, unknown>) => rpcImpl(fn, args));
+  return { client: { rpc } as unknown as SupabaseClient, rpc };
+}
+
+const BASE = "https://ironedge.example.com";
+function signed(method: string, path: string, body = "", now = Date.now(), extra: Record<string, string> = {}) {
+  return { method, url: BASE + path, body, headers: new Headers({ ...signedHeaders(SECRET, method, path, body, now), ...extra }) };
+}
+
+describe("protocollo firmato", () => {
+  it("firma valida accettata; corpo o path manomessi rifiutati", () => {
+    const now = Date.now();
+    const h = new Headers(signedHeaders(SECRET, "POST", "/api/x", '{"a":1}', now));
+    expect(verifySignedRequest(SECRET, { method: "POST", path: "/api/x", headers: h, body: '{"a":1}' }, now).ok).toBe(true);
+    expect(verifySignedRequest(SECRET, { method: "POST", path: "/api/x", headers: h, body: '{"a":2}' }, now).ok).toBe(false);
+    expect(verifySignedRequest(SECRET, { method: "POST", path: "/api/y", headers: h, body: '{"a":1}' }, now).ok).toBe(false);
+    expect(verifySignedRequest("x".repeat(40), { method: "POST", path: "/api/x", headers: h, body: '{"a":1}' }, now).ok).toBe(false);
+  });
+  it("timestamp fuori finestra rifiutato", () => {
+    const now = Date.now();
+    const h = new Headers(signedHeaders(SECRET, "GET", "/a", "", now - 10 * 60_000));
+    expect(verifySignedRequest(SECRET, { method: "GET", path: "/a", headers: h, body: "" }, now)).toMatchObject({ ok: false, status: 401 });
+  });
+  it("segreto corto non utilizzabile", () => {
+    expect(() => signedHeaders("short", "GET", "/a")).toThrow();
+  });
+});
+
+describe("handler API Personal OS", () => {
+  it("503 se non configurata, senza toccare il database", async () => {
+    const { client, rpc } = fakeAdmin(() => ({ data: null, error: null }));
+    const r = await handlePersonalOs(client, env({ PERSONAL_OS_SHARED_SECRET: undefined }), signed("GET", "/api/integrations/personal-os"));
+    expect(r.status).toBe(503);
+    expect(rpc).not.toHaveBeenCalled();
+  });
+
+  it("401 su firma errata; replay rifiutato", async () => {
+    const { client } = fakeAdmin((fn) => ({ data: fn === "integration_use_nonce" ? false : [], error: null }));
+    const bad = signed("GET", "/api/integrations/personal-os?from=2026-11-01&to=2026-11-30");
+    bad.headers.set(HEADER.signature, "0".repeat(64));
+    expect((await handlePersonalOs(client, env(), bad)).status).toBe(401);
+    const replay = await handlePersonalOs(client, env(), signed("GET", "/api/integrations/personal-os?from=2026-11-01&to=2026-11-30"));
+    expect(replay.status).toBe(401);
+  });
+
+  it("GET: usa SEMPRE il workspace configurato e mappa il contratto", async () => {
+    const row = {
+      occurrence_id: OCC, task_id: WS, title: "Preparare la live", description: null, priority: 2, due_date: null,
+      occurrence_date: "2026-11-26", estimated_minutes: 45, status: "open", category: "live", depends_on: null,
+      completed_at: null, version: "2026-11-26T08:00:00+00:00", task_active: true,
+    };
+    const { client, rpc } = fakeAdmin((fn) => ({ data: fn === "integration_use_nonce" ? true : [row], error: null }));
+    const r = await handlePersonalOs(client, env(), signed("GET", "/api/integrations/personal-os?from=2026-11-20&to=2026-12-10&limit=50"));
+    expect(r.status).toBe(200);
+    const body = r.body as { items: { url: string; depends_on: string[]; version: string }[]; next_cursor: string; has_more: boolean };
+    expect(body.items[0].depends_on).toEqual([]);
+    expect(body.items[0].url).toBe(`${BASE}/impostazioni#task-${WS}`);
+    expect(body.next_cursor).toBe("2026-11-26T08:00:00.000Z");
+    expect(rpc.mock.calls.find((c) => c[0] === "integration_list_tasks")?.[1]).toMatchObject({ p_ws: WS, p_limit: 51 });
+  });
+
+  it("GET: intervallo date eccessivo rifiutato", async () => {
+    const { client } = fakeAdmin(() => ({ data: true, error: null }));
+    const r = await handlePersonalOs(client, env(), signed("GET", "/api/integrations/personal-os?from=2026-01-01&to=2026-12-31"));
+    expect(r.status).toBe(400);
+  });
+
+  it("POST: campi extra (es. dati personali) rifiutati dallo schema strict", async () => {
+    const { client, rpc } = fakeAdmin(() => ({ data: true, error: null }));
+    const body = JSON.stringify({ external_id: `occ:${OCC}`, status: "done", base_version: null, sleep_hours: 6 });
+    const r = await handlePersonalOs(client, env(), signed("POST", "/api/integrations/personal-os", body, Date.now(), { [HEADER.idempotency]: "task:abc:12345678" }));
+    expect(r.status).toBe(400);
+    expect(rpc.mock.calls.some((c) => c[0] === "integration_set_occurrence_status")).toBe(false);
+  });
+
+  it("POST: applica con attore configurato; conflitto -> 409 con stato IronEdge", async () => {
+    let result = "applied";
+    const { client, rpc } = fakeAdmin((fn) =>
+      fn === "integration_use_nonce"
+        ? { data: true, error: null }
+        : { data: { result, status: result === "applied" ? "done" : "skipped", version: "2026-11-26T09:00:00Z", completed_at: null }, error: null },
+    );
+    const body = JSON.stringify({ external_id: `occ:${OCC}`, status: "done", base_version: "2026-11-26T08:00:00.000Z" });
+    const ok = await handlePersonalOs(client, env(), signed("POST", "/api/integrations/personal-os", body, Date.now(), { [HEADER.idempotency]: "task:abc:12345678" }));
+    expect(ok.status).toBe(200);
+    expect(rpc.mock.calls.find((c) => c[0] === "integration_set_occurrence_status")?.[1]).toMatchObject({ p_ws: WS, p_actor: ACTOR, p_occurrence: OCC, p_status: "done" });
+    result = "conflict";
+    const conflict = await handlePersonalOs(client, env(), signed("POST", "/api/integrations/personal-os", body, Date.now(), { [HEADER.idempotency]: "task:abc:99999999" }));
+    expect(conflict.status).toBe(409);
+    expect((conflict.body as { status: string }).status).toBe("skipped");
+  });
+
+  it("POST senza Idempotency-Key rifiutato", async () => {
+    const { client } = fakeAdmin(() => ({ data: true, error: null }));
+    const body = JSON.stringify({ external_id: `occ:${OCC}`, status: "done", base_version: null });
+    expect((await handlePersonalOs(client, env(), signed("POST", "/api/integrations/personal-os", body))).status).toBe(400);
+  });
+});
