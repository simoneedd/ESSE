diff --git a/src/lib/personal-os-protocol.ts b/src/lib/personal-os-protocol.ts
new file mode 100644
index 0000000..6dd5ed0
--- /dev/null
+++ b/src/lib/personal-os-protocol.ts
@@ -0,0 +1,141 @@
+import { createHash, createHmac, randomBytes, timingSafeEqual } from "node:crypto";
+import { z } from "zod";
+
+/**
+ * Protocollo server-to-server Personal OS <-> IronEdge Growth OS (v1).
+ *
+ * File IDENTICO nei due repository (IronEdge: src/lib/personal-os-protocol.ts).
+ *
+ * Sicurezza:
+ *  - firma HMAC-SHA256 con segreto condiviso (>= 32 caratteri) conservato SOLO lato server
+ *    (env PERSONAL_OS_SHARED_SECRET in IronEdge, IRONEDGE_SHARED_SECRET in Personal OS);
+ *  - la firma copre metodo, path, timestamp, nonce e hash del corpo: nessuna manomissione;
+ *  - finestra temporale +-300 s e nonce monouso (replay protection lato IronEdge);
+ *  - permessi minimi: l'API espone solo lettura delle task di UN workspace e il cambio di stato
+ *    di un'occorrenza (open/done). Nessun'altra tabella e' raggiungibile.
+ *  - minimizzazione: Personal OS invia SOLO {external_id, status, base_version}; i dati personali,
+ *    alimentari e sanitari non hanno alcun campo nel contratto e vengono rifiutati (schema strict).
+ */
+
+export const PROTOCOL_VERSION = "pos-v1";
+export const MAX_SKEW_SECONDS = 300;
+export const MAX_BODY_BYTES = 16_384;
+
+export const HEADER = {
+  version: "x-pos-version",
+  timestamp: "x-pos-timestamp",
+  nonce: "x-pos-nonce",
+  signature: "x-pos-signature",
+  idempotency: "idempotency-key",
+} as const;
+
+export function sha256Hex(input: string): string {
+  return createHash("sha256").update(input, "utf8").digest("hex");
+}
+
+export function canonicalString(method: string, path: string, timestamp: string, nonce: string, body: string): string {
+  return [PROTOCOL_VERSION, method.toUpperCase(), path, timestamp, nonce, sha256Hex(body)].join("\n");
+}
+
+export function sign(secret: string, method: string, path: string, timestamp: string, nonce: string, body: string): string {
+  return createHmac("sha256", secret).update(canonicalString(method, path, timestamp, nonce, body)).digest("hex");
+}
+
+export function newNonce(): string {
+  return randomBytes(16).toString("hex");
+}
+
+/** Header firmati per una richiesta in uscita. `path` include la query string. */
+export function signedHeaders(secret: string, method: string, path: string, body = "", now = Date.now(), nonce = newNonce()): Record<string, string> {
+  if (!secret || secret.length < 32) throw new Error("Segreto di integrazione assente o troppo corto");
+  const ts = String(Math.floor(now / 1000));
+  return {
+    [HEADER.version]: PROTOCOL_VERSION,
+    [HEADER.timestamp]: ts,
+    [HEADER.nonce]: nonce,
+    [HEADER.signature]: sign(secret, method, path, ts, nonce, body),
+  };
+}
+
+export type VerifyResult = { ok: true; nonce: string; timestamp: number } | { ok: false; status: 400 | 401; reason: string };
+
+/** Verifica a tempo costante. Il controllo del nonce (replay) va fatto poi su database. */
+export function verifySignedRequest(
+  secret: string | undefined,
+  req: { method: string; path: string; headers: Headers; body: string },
+  now = Date.now(),
+): VerifyResult {
+  if (!secret || secret.length < 32) return { ok: false, status: 401, reason: "integrazione non configurata" };
+  if (req.headers.get(HEADER.version) !== PROTOCOL_VERSION) return { ok: false, status: 400, reason: "versione protocollo" };
+  const ts = req.headers.get(HEADER.timestamp) ?? "";
+  const nonce = req.headers.get(HEADER.nonce) ?? "";
+  const sig = req.headers.get(HEADER.signature) ?? "";
+  if (!/^\d{9,11}$/.test(ts) || !/^[a-f0-9]{32}$/.test(nonce) || !/^[a-f0-9]{64}$/.test(sig)) {
+    return { ok: false, status: 401, reason: "header firma non validi" };
+  }
+  const t = Number(ts);
+  if (Math.abs(now / 1000 - t) > MAX_SKEW_SECONDS) return { ok: false, status: 401, reason: "timestamp fuori finestra" };
+  if (Buffer.byteLength(req.body, "utf8") > MAX_BODY_BYTES) return { ok: false, status: 400, reason: "corpo troppo grande" };
+  const expected = Buffer.from(sign(secret, req.method, req.path, ts, nonce, req.body), "hex");
+  const given = Buffer.from(sig, "hex");
+  if (expected.length !== given.length || !timingSafeEqual(expected, given)) return { ok: false, status: 401, reason: "firma non valida" };
+  return { ok: true, nonce, timestamp: t };
+}
+
+// ---------------------------------------------------------------------------
+// Contratto dati
+// ---------------------------------------------------------------------------
+const isoDate = z.string().regex(/^\d{4}-\d{2}-\d{2}$/);
+
+/** Una occorrenza di task IronEdge come esposta a Personal OS. */
+export const remoteTaskSchema = z.object({
+  occurrence_id: z.uuid(),
+  task_id: z.uuid(),
+  title: z.string().min(1).max(200),
+  description: z.string().max(8000).nullable(),
+  priority: z.number().int().min(1).max(4).nullable(),
+  due_date: isoDate.nullable(),
+  occurrence_date: isoDate,
+  estimated_minutes: z.number().int().min(5).max(1440).nullable(),
+  status: z.enum(["open", "done", "skipped"]),
+  category: z.string().max(80).nullable(),
+  depends_on: z.array(z.uuid()).max(50),
+  completed_at: z.string().nullable(),
+  version: z.string().min(1).max(64), // updated_at dell'occorrenza (ISO)
+  task_active: z.boolean(),
+  url: z.string().max(500),
+});
+export type RemoteTask = z.infer<typeof remoteTaskSchema>;
+
+export const listResponseSchema = z.object({
+  protocol: z.literal(PROTOCOL_VERSION),
+  items: z.array(remoteTaskSchema).max(500),
+  next_cursor: z.string().max(64).nullable(),
+  has_more: z.boolean(),
+  server_time: z.string(),
+});
+export type ListResponse = z.infer<typeof listResponseSchema>;
+
+/** Unica scrittura consentita: cambio di stato. strict(): qualsiasi campo extra viene rifiutato. */
+export const statusUpdateSchema = z
+  .object({
+    external_id: z.string().regex(/^occ:[0-9a-f-]{36}$/),
+    status: z.enum(["open", "done"]),
+    base_version: z.string().max(64).nullable(),
+  })
+  .strict();
+export type StatusUpdate = z.infer<typeof statusUpdateSchema>;
+
+export const statusResponseSchema = z.object({
+  protocol: z.literal(PROTOCOL_VERSION),
+  result: z.enum(["applied", "noop", "conflict", "not_found"]),
+  status: z.enum(["open", "done", "skipped"]).nullable(),
+  version: z.string().nullable(),
+  completed_at: z.string().nullable(),
+});
+export type StatusResponse = z.infer<typeof statusResponseSchema>;
+
+export const occurrenceIdFromExternal = (externalId: string): string | null => {
+  const m = /^occ:([0-9a-f-]{36})$/.exec(externalId);
+  return m ? m[1] : null;
+};
diff --git a/src/lib/personal-os.ts b/src/lib/personal-os.ts
new file mode 100644
index 0000000..141b222
--- /dev/null
+++ b/src/lib/personal-os.ts
@@ -0,0 +1,167 @@
+import type { SupabaseClient } from "@supabase/supabase-js";
+import { z } from "zod";
+import type { ServerEnv } from "./env";
+import {
+  HEADER,
+  PROTOCOL_VERSION,
+  occurrenceIdFromExternal,
+  statusUpdateSchema,
+  verifySignedRequest,
+  type ListResponse,
+  type RemoteTask,
+  type StatusResponse,
+} from "./personal-os-protocol";
+import { log, rateLimit, redact } from "./security";
+
+/**
+ * API di integrazione per Personal OS (vedi personal-os-protocol.ts).
+ * Permessi minimi: un solo workspace (PERSONAL_OS_WORKSPACE_ID), lettura task/occorrenze,
+ * cambio di stato open/done firmato dall'utente PERSONAL_OS_ACTOR_USER_ID (owner/editor).
+ * IronEdge resta la fonte autorevole: in caso di conflitto non scrive e restituisce il proprio stato.
+ */
+export type Json = { status: number; body: unknown };
+
+export function personalOsConfig(env: ServerEnv) {
+  if (!env.PERSONAL_OS_SHARED_SECRET || !env.PERSONAL_OS_WORKSPACE_ID || !env.PERSONAL_OS_ACTOR_USER_ID) return null;
+  return { secret: env.PERSONAL_OS_SHARED_SECRET, workspaceId: env.PERSONAL_OS_WORKSPACE_ID, actorId: env.PERSONAL_OS_ACTOR_USER_ID };
+}
+
+const listQuery = z.object({
+  since: z.iso.datetime({ offset: true }).nullable(),
+  from: z.string().regex(/^\d{4}-\d{2}-\d{2}$/),
+  to: z.string().regex(/^\d{4}-\d{2}-\d{2}$/),
+  limit: z.coerce.number().int().min(1).max(500).default(200),
+});
+
+type Row = {
+  occurrence_id: string;
+  task_id: string;
+  title: string;
+  description: string | null;
+  priority: number | null;
+  due_date: string | null;
+  occurrence_date: string;
+  estimated_minutes: number | null;
+  status: "open" | "done" | "skipped";
+  category: string | null;
+  depends_on: string[] | null;
+  completed_at: string | null;
+  version: string;
+  task_active: boolean;
+};
+
+const iso = (v: string | Date | null) => (v ? new Date(v).toISOString() : null);
+/** PostgREST restituisce le date come stringhe, i driver Postgres come Date: normalizza a YYYY-MM-DD. */
+const dateOnly = (v: string | Date | null): string | null => (v == null ? null : v instanceof Date ? v.toISOString().slice(0, 10) : String(v).slice(0, 10));
+
+async function authenticate(
+  admin: SupabaseClient,
+  cfg: NonNullable<ReturnType<typeof personalOsConfig>>,
+  req: { method: string; path: string; headers: Headers; body: string },
+  now: number,
+): Promise<Json | null> {
+  const v = verifySignedRequest(cfg.secret, req, now);
+  if (!v.ok) {
+    log.warn("personal-os: richiesta rifiutata", v.reason);
+    return { status: v.status, body: { error: "Non autorizzato" } };
+  }
+  const { data: fresh, error } = await admin.rpc("integration_use_nonce", { p_nonce: v.nonce });
+  if (error) throw new Error(`nonce: ${error.message}`);
+  if (!fresh) return { status: 401, body: { error: "Richiesta gia' ricevuta (replay)" } };
+  return null;
+}
+
+export async function handlePersonalOs(
+  admin: SupabaseClient,
+  env: ServerEnv,
+  req: { method: string; url: string; headers: Headers; body: string },
+  now = Date.now(),
+): Promise<Json> {
+  const cfg = personalOsConfig(env);
+  if (!cfg) return { status: 503, body: { error: "Integrazione Personal OS non configurata" } };
+  if (!rateLimit("personal-os", 120, 60_000, now)) return { status: 429, body: { error: "Troppe richieste" } };
+  const url = new URL(req.url);
+  const path = url.pathname + url.search;
+  try {
+    const denied = await authenticate(admin, cfg, { method: req.method, path, headers: req.headers, body: req.body }, now);
+    if (denied) return denied;
+
+    if (req.method === "GET") {
+      const q = listQuery.safeParse({
+        since: url.searchParams.get("since"),
+        from: url.searchParams.get("from"),
+        to: url.searchParams.get("to"),
+        limit: url.searchParams.get("limit") ?? undefined,
+      });
+      if (!q.success) return { status: 400, body: { error: "Parametri non validi" } };
+      const spanDays = (Date.parse(q.data.to) - Date.parse(q.data.from)) / 86_400_000;
+      if (spanDays < 0 || spanDays > 62) return { status: 400, body: { error: "Intervallo date non valido (max 62 giorni)" } };
+      const { data, error } = await admin.rpc("integration_list_tasks", {
+        p_ws: cfg.workspaceId,
+        p_since: q.data.since,
+        p_from: q.data.from,
+        p_to: q.data.to,
+        p_limit: q.data.limit + 1,
+      });
+      if (error) throw new Error(error.message);
+      const rows = (data ?? []) as Row[];
+      const page = rows.slice(0, q.data.limit);
+      const items: RemoteTask[] = page.map((r) => ({
+        occurrence_id: r.occurrence_id,
+        task_id: r.task_id,
+        title: r.title,
+        description: r.description,
+        priority: r.priority,
+        due_date: dateOnly(r.due_date),
+        occurrence_date: dateOnly(r.occurrence_date)!,
+        estimated_minutes: r.estimated_minutes,
+        status: r.status,
+        category: r.category,
+        depends_on: r.depends_on ?? [],
+        completed_at: iso(r.completed_at),
+        version: iso(r.version)!,
+        task_active: r.task_active,
+        url: `${url.origin}/impostazioni#task-${r.task_id}`,
+      }));
+      const body: ListResponse = {
+        protocol: PROTOCOL_VERSION,
+        items,
+        next_cursor: items.length ? items[items.length - 1].version : q.data.since,
+        has_more: rows.length > q.data.limit,
+        server_time: new Date(now).toISOString(),
+      };
+      return { status: 200, body };
+    }
+
+    if (req.method === "POST") {
+      let raw: unknown;
+      try {
+        raw = JSON.parse(req.body);
+      } catch {
+        return { status: 400, body: { error: "JSON non valido" } };
+      }
+      const parsed = statusUpdateSchema.safeParse(raw);
+      if (!parsed.success) return { status: 400, body: { error: "Payload non valido: sono ammessi solo external_id, status, base_version" } };
+      const occ = occurrenceIdFromExternal(parsed.data.external_id);
+      if (!occ) return { status: 400, body: { error: "external_id non valido" } };
+      const idem = req.headers.get(HEADER.idempotency);
+      if (!idem || !/^[\w:.-]{8,120}$/.test(idem)) return { status: 400, body: { error: "Idempotency-Key mancante" } };
+      const { data, error } = await admin.rpc("integration_set_occurrence_status", {
+        p_ws: cfg.workspaceId,
+        p_occurrence: occ,
+        p_status: parsed.data.status,
+        p_actor: cfg.actorId,
+        p_base_version: parsed.data.base_version,
+      });
+      if (error) throw new Error(error.message);
+      const r = data as { result: StatusResponse["result"]; status: StatusResponse["status"]; version: string | null; completed_at: string | null };
+      const body: StatusResponse = { protocol: PROTOCOL_VERSION, result: r.result, status: r.status, version: iso(r.version), completed_at: iso(r.completed_at) };
+      return { status: r.result === "conflict" ? 409 : r.result === "not_found" ? 404 : 200, body };
+    }
+
+    return { status: 405, body: { error: "Metodo non consentito" } };
+  } catch (e) {
+    log.error("personal-os: errore", e);
+    return { status: 500, body: { error: redact(e, 200) } };
+  }
+}
