+
+describe("integrazione Personal OS (DB)", () => {
+  it("le nuove colonne sono opzionali: il codice esistente continua a inserire task", async () => {
+    await db.as(USER_A, async () => {
+      await db.query("insert into public.tasks (workspace_id, title, recurrence) values ($1, 'Task legacy', 'daily')", [wsA]);
+      const t = await one<{ priority: number | null; depends_on: string[] }>("select priority, depends_on from public.tasks where title = 'Task legacy'");
+      expect(t.priority).toBeNull();
+      expect(t.depends_on).toEqual([]);
+    });
+  });
+
+  it("funzioni riservate al service role", async () => {
+    await db.as(USER_A, async () => {
+      await expect(db.query("select * from public.integration_list_tasks($1, null, '2026-11-01', '2026-11-30', 10)", [wsA])).rejects.toThrow(/permission denied|Solo service/);
+      await expect(db.query("select public.integration_use_nonce('aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa')")).rejects.toThrow(/permission denied|Solo service/);
+      await expect(db.query("select * from public.integration_nonces")).rejects.toThrow(/permission denied/);
+    });
+  });
+
+  it("list: solo il workspace richiesto, cursore incrementale", async () => {
+    await db.asService(async () => {
+      const all = await db.query<{ occurrence_id: string; version: string }>("select * from public.integration_list_tasks($1, null, '2026-11-26', '2026-11-26', 100)", [wsA]);
+      expect(all.rows.length).toBe(6);
+      expect(all.rows.some((r) => r.occurrence_id === occB)).toBe(false);
+      const maxVer = all.rows[all.rows.length - 1].version;
+      const none = await db.query("select * from public.integration_list_tasks($1, $2, '2026-11-26', '2026-11-26', 100)", [wsA, maxVer]);
+      expect(none.rows.length).toBe(0);
+    });
+  });
+
+  it("nonce monouso (replay)", async () => {
+    await db.asService(async () => {
+      expect((await one<{ ok: boolean }>("select public.integration_use_nonce('bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb') ok")).ok).toBe(true);
+      expect((await one<{ ok: boolean }>("select public.integration_use_nonce('bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb') ok")).ok).toBe(false);
+    });
+  });
+
+  it("set status: applied, poi noop idempotente, con audit e completed_by = attore", async () => {
+    await db.asService(async () => {
+      const r1 = await one<{ r: { result: string; status: string } }>("select public.integration_set_occurrence_status($1, $2, 'done', $3, null) r", [wsA, occA, USER_A]);
+      expect(r1.r.result).toBe("applied");
+      const o = await one<{ status: string; completed_by: string }>("select status, completed_by from public.task_occurrences where id = $1", [occA]);
+      expect(o).toEqual({ status: "done", completed_by: USER_A });
+      const r2 = await one<{ r: { result: string } }>("select public.integration_set_occurrence_status($1, $2, 'done', $3, null) r", [wsA, occA, USER_A]);
+      expect(r2.r.result).toBe("noop");
+      const audit = await one<{ n: number }>("select count(*)::int n from public.audit_events where entity_id = $1 and action = 'personal_os_status'", [occA]);
+      expect(audit.n).toBe(1);
+    });
+  });
+
+  it("conflitto: modifica in IronEdge successiva alla versione nota -> nessuna scrittura", async () => {
+    await db.asService(async () => {
+      const old = "2000-01-01T00:00:00Z";
+      const r = await one<{ r: { result: string; status: string } }>("select public.integration_set_occurrence_status($1, $2, 'open', $3, $4) r", [wsA, occA, USER_A, old]);
+      expect(r.r.result).toBe("conflict");
+      expect((await one<{ status: string }>("select status from public.task_occurrences where id = $1", [occA])).status).toBe("done");
+    });
+  });
+
+  it("isolamento: occorrenza di un altro workspace = not_found; attore analyst o estraneo rifiutato", async () => {
+    await db.asService(async () => {
+      const r = await one<{ r: { result: string } }>("select public.integration_set_occurrence_status($1, $2, 'done', $3, null) r", [wsA, occB, USER_A]);
+      expect(r.r.result).toBe("not_found");
+      await expect(db.query("select public.integration_set_occurrence_status($1, $2, 'done', $3, null)", [wsA, occA, USER_C])).rejects.toThrow(/non autorizzato/);
+      await expect(db.query("select public.integration_set_occurrence_status($1, $2, 'done', $3, null)", [wsA, occA, USER_B])).rejects.toThrow(/non autorizzato/);
+      await expect(db.query("select public.integration_set_occurrence_status($1, $2, 'skipped', $3, null)", [wsA, occA, USER_A])).rejects.toThrow(/non consentito/);
+    });
+  });
+});
