+  wsB = await db.as(USER_B, async () => (await one<{ id: string }>("select public.create_workspace('Tenant B') id")).id);
+  await db.as(USER_A, () => db.query("insert into public.memberships (workspace_id, user_id, role) values ($1, $2, 'analyst')", [wsA, USER_C]));
+  await db.as(USER_A, () => db.query("select public.generate_task_occurrences($1, '2026-11-26')", [wsA]));
+  await db.as(USER_B, () => db.query("select public.generate_task_occurrences($1, '2026-11-26')", [wsB]));
+  occA = (await db.asService(() => one<{ id: string }>("select id from public.task_occurrences where workspace_id = $1 limit 1", [wsA]))).id;
+  occB = (await db.asService(() => one<{ id: string }>("select id from public.task_occurrences where workspace_id = $1 limit 1", [wsB]))).id;
