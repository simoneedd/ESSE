+import { NextResponse } from "next/server";
+import { serverEnv } from "@/lib/env";
+import { handlePersonalOs } from "@/lib/personal-os";
+import { MAX_BODY_BYTES } from "@/lib/personal-os-protocol";
+import { supabaseAdmin } from "@/lib/supabase/server";
+
+export const dynamic = "force-dynamic";
+export const maxDuration = 30;
+
+/**
+ * Integrazione server-to-server con Personal OS (richieste firmate HMAC, nonce monouso).
+ * GET  ?since=&from=&to=&limit=  -> occorrenze task del workspace configurato
+ * POST {external_id, status, base_version} -> cambio stato open/done (IronEdge autorevole)
+ */
+async function handle(req: Request) {
+  const len = Number(req.headers.get("content-length") ?? 0);
+  if (len > MAX_BODY_BYTES) return NextResponse.json({ error: "Corpo troppo grande" }, { status: 413 });
+  const body = req.method === "GET" ? "" : (await req.text()).slice(0, MAX_BODY_BYTES + 1);
+  const env = serverEnv();
+  if (!env.PERSONAL_OS_SHARED_SECRET) return NextResponse.json({ error: "Integrazione non configurata" }, { status: 503 });
+  const r = await handlePersonalOs(supabaseAdmin(), env, { method: req.method, url: req.url, headers: req.headers, body });
+  return NextResponse.json(r.body, { status: r.status, headers: { "Cache-Control": "no-store" } });
+}
+
+export const GET = handle;
+export const POST = handle;
